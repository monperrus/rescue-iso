#!/bin/sh
# Rescue boot: DHCP on every NIC, root password, on-screen banner.
# Runs once from OpenRC's `local` service; the banner loop keeps running in background.

PASSWORD="$(cat /etc/rescue/password)"
echo "root:$PASSWORD" | chpasswd

for dev in /sys/class/net/*; do
	ifname="${dev##*/}"
	[ "$ifname" = lo ] && continue
	ip link set "$ifname" up
	udhcpc -b -q -S -i "$ifname" -x hostname:tiramisu-rescue >/dev/null 2>&1
done

addresses() {
	ip -4 -o addr show scope global | awk '{print $2 " " $4}'
}

banner() {
	printf '\n=================== TIRAMISU RESCUE ===================\n'
	printf '  ssh root@<ip>      password: %s\n' "$PASSWORD"
	printf '  (the authorized key is also accepted)\n'
	printf '  addresses:\n'
	addresses | sed 's/^/    /'
	printf '  sshd host keys:\n'
	for k in /etc/ssh/ssh_host_*_key.pub; do
		ssh-keygen -lf "$k" | sed 's/^/    /'
	done
	printf '========================================================\n\n'
}

(
	last=""
	n=0
	while true; do
		current="$(addresses)"
		banner > /etc/issue
		if [ "$current" != "$last" ]; then
			banner > /dev/tty1
			last="$current"
		fi
		# re-announce every 10 minutes even if nothing changed
		n=$((n + 1))
		[ $((n % 60)) -eq 0 ] && banner > /dev/tty1
		sleep 10
	done
) >/dev/null 2>&1 &
